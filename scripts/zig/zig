#!/bin/sh
set -eu
: "${CODESH_ZIG:?Set CODESH_ZIG to the real Zig executable}"

# The pinned native VT build otherwise specializes code to the build host CPU.
if [ "${1:-}" = build ]; then
    for argument in "$@"; do
        if [ "$argument" = -Demit-lib-vt=true ]; then
            exec "$CODESH_ZIG" "$@" -Dcpu=baseline
        fi
    done
fi
exec "$CODESH_ZIG" "$@"
